<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Block common malicious query strings
    RewriteCond %{QUERY_STRING} (_0x|base64|eval\(|atob\(|fromCharCode|script|iframe|document\.cookie|cutme\.today) [NC]
    RewriteRule .* - [F,L]

    # Allow existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # CodeIgniter front controller
    RewriteRule ^(.*)$ index.php?/$1 [L,QSA]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin"
</IfModule>
